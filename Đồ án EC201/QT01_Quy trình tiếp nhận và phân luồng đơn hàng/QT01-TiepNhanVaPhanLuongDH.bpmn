    <bpmn:textAnnotation id="TextAnnotation_0enw9lq">
      <bpmn:text>Khách được hủy đơn và hoàn tiền theo quy định (nếu có) trong vòng 1 giờ kể từ lúc nhân viên bán hàng liên hệ xác nhận.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1jsyr68">
      <bpmn:text>Rà soát dấu hiệu đầu cơ (đơn hàng&gt;10 triệu VND), lợi dụng lỗi hệ thống về giá, hoặc vi phạm số lượng mua tối đa trong các Chương trình khuyến mại.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1flfgef">
      <bpmn:text>Form_DH</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0d9tyw6">
